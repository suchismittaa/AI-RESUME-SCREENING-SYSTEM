# --- LLM (optional). Without a key the pipeline runs fully deterministically. ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_CONCURRENCY=4
LLM_BLEND_WEIGHT=0.5

# --- GitHub enrichment (optional token raises rate limit from 60 to 5000 req/h) ---
GITHUB_TOKEN=
GITHUB_MAX_CONCURRENCY=4
GITHUB_CACHE_PATH=.cache/github.json
GITHUB_CACHE_TTL_HOURS=24
